
# ---- NVIDIA ----
NVIDIA_API_KEY=

# ---- OPENROUTER ----
OPENROUTER_API_KEY=

OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# ---- OLLAMA (LOCAL) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ---- LANGFUSE ----
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ---- OPENAI / CUSTOM OPENAI-COMPATIBLE API ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Supported aliases: keyOpenAI, base_url_openAI, model_openAI

EMBEDDING_MODEL=text-embedding-3-small
# Persistent Neo4j connection used by the Graphiti baseline.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# AURA_INSTANCEID=781696e7
# AURA_INSTANCENAME="Free instance"

# Separate Neo4j connection used by GSM Operational KG v1.
# Keep this namespace separate from the Graphiti baseline connection above.
NEO4J_OPERATIONAL_URI=
NEO4J_OPERATIONAL_USERNAME=
NEO4J_OPERATIONAL_PASSWORD=
NEO4J_OPERATIONAL_DATABASE=
 
# Keep initial ingestion conservative; increase only after a successful smoke run.
SEMAPHORE_LIMIT=2


# ---- NVIDIA ----
NVIDIA_API_KEY=

# ---- OPENROUTER ----
OPENROUTER_API_KEY=

OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# ---- LANGFUSE ----
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# OpenAI used by Graphiti for extraction, embeddings, and reranking.
OPENAI_API_KEY=

EMBEDDING_MODEL=text-embedding-3-small
# Persistent Neo4j connection used by the Graphiti baseline.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# AURA_INSTANCEID=781696e7
# AURA_INSTANCENAME="Free instance"

# Separate Neo4j connection used by GSM Operational KG v1.
# Keep this namespace separate from the Graphiti baseline connection above.
NEO4J_OPERATIONAL_URI=
NEO4J_OPERATIONAL_USERNAME=
NEO4J_OPERATIONAL_PASSWORD=
NEO4J_OPERATIONAL_DATABASE=

# Separate Neo4j connection reserved for the experimental Operational KG v2.
# Do not point these variables at the Graphiti, Oracle, or Operational KG v1 database.
NEO4J_OPERATIONAL_V2_URI=
NEO4J_OPERATIONAL_V2_USERNAME=
NEO4J_OPERATIONAL_V2_PASSWORD=
NEO4J_OPERATIONAL_V2_DATABASE=
# NEO4J_OPERATIONAL_V2_INSTANCEID=
# NEO4J_OPERATIONAL_V2_INSTANCENAME="Free instance"

# Separate Neo4j namespace for the smaller Operational KG v3 candidate.
# V3 removes synthetic Shift/Summary nodes and never deletes or rewrites v2.
NEO4J_OPERATIONAL_V3_URI=
NEO4J_OPERATIONAL_V3_USERNAME=
NEO4J_OPERATIONAL_V3_PASSWORD=
NEO4J_OPERATIONAL_V3_DATABASE=
# NEO4J_OPERATIONAL_V3_INSTANCEID=
# NEO4J_OPERATIONAL_V3_INSTANCENAME="Free instance"

# Dedicated Qdrant Cloud collection for policy dense+sparse native hybrid search.
# Keep existing collections intact; v2 uses a new collection name.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=gsm_policy_chunks_v2
QDRANT_TIMEOUT_SECONDS=60

# Keep initial ingestion conservative; increase only after a successful smoke run.
SEMAPHORE_LIMIT=2

{
  "config_version": "1.0.0",
  "description": "Canonical pinned retrieval configuration for GSM Agent Phase B",
  "embedding_model": "nvidia/nemotron-3-embed-1b",
  "llm_model": "meta-llama/llama-3.1-8b-instruct",
  "query_planner_provider": "openrouter",
  "query_planner_max_output_tokens": 900,
  "reranker_model": "nvidia/rerank-qa-mistral-4b",
  "dense_index_path": null,
  "chunker": "gsm-word-span-v1",
  "tokenizer": "unicode-word-regex-v1",
  "max_tokens": 180,
  "overlap": 30,
  "rrf_k": 60,
  "bm25_weight": 0.5,
  "dense_weight": 0.5,
  "document_top_k": 10,
  "dense_top_k": 10,
  "bm25_top_k": 10,
  "rerank_top_n": 20,
  "kg_top_k": 40,
  "seed_top_k": 3,
  "max_hops": 2,
  "max_nodes": 20,
  "max_edges": 30,
  "per_node_fanout": 10,
  "token_budget": 1800,
  "max_selected_items": 22,
  "modality_quotas": {
    "computation": 1,
    "document": 2,
    "kg": 2,
    "entity_catalog": 1,
    "definition": 1,
    "coverage": 1

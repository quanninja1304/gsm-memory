  "runtime_stores": {
    "neo4j": {
      "env_prefix": "NEO4J_OPERATIONAL_V2",
      "marker_label": "GSMOperationalV2",
      "identity_strategy": "id_equals_canonical_id"
    },
    "qdrant": {
      "collection": "gsm_policy_chunks_v2",
      "query_mode": "native_hybrid",
      "fusion": "rrf",
      "vectors": [
        {
          "name": "dense",
          "purpose": "semantic_similarity",
          "model": "intfloat/multilingual-e5-small",
          "status": "provisional_baseline_requires_vietnamese_evaluation",
          "dimensions": 384,
          "document_prefix": "passage: ",
          "query_prefix": "query: "
        },
        {
          "name": "sparse",
          "purpose": "lexical_precision",
          "model": "qdrant/bm25",
          "status": "provisional_baseline_requires_vietnamese_evaluation",
          "dimensions": null,
          "document_prefix": "",
          "query_prefix": ""
        }
      ],
      "payload_join_keys": [
        "chunk_id",
        "clause_ids",
        "content_sha256",
        "dataset_version",
        "document_id",
        "document_revision_id"
      ],
      "external_bm25_store": false
    }
  },
